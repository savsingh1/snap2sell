# Copy this file to `.env` (git-ignored) for local reference, but the app
# actually reads keys from --dart-define at build/run time:
#
#   flutter run --dart-define=GEMINI_API_KEY=your-key-here
#
# Free keys (no credit card) from https://aistudio.google.com.
#
# When GEMINI_API_KEY is empty the app uses the built-in MockAiService,
# so it demos with zero keys and zero cost.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
