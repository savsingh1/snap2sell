# Copy this file to `.env` (git-ignored) for local reference, but the app
# actually reads these from --dart-define at build/run time:
#
#   flutter run --dart-define=AI_BACKEND_URL=https://your-function-url \
#               --dart-define=APP_API_SECRET=your-app-secret
#
# The Gemini API key NEVER goes here and NEVER ships in the app — it lives
# in Secret Manager on the Snap2Sell backend (Cloud Function), which holds
# the key and calls Gemini server-side.
#
# When AI_BACKEND_URL is empty the app uses the built-in MockAiService,
# so it demos with zero keys and zero cost.

AI_BACKEND_URL=
APP_API_SECRET=
