# Copy this file to `.env` (git-ignored) for local reference, but the app
# actually reads keys from --dart-define at build/run time:
#
#   flutter run --dart-define=OPENAI_API_KEY=sk-your-key-here
#
# When OPENAI_API_KEY is empty the app uses the built-in MockAiService,
# so it demos with zero keys and zero cost.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
